# Copie ce fichier en .env (non versionné).
# Ton uid/gid (commande `id`), pour que cerveau/ ne soit pas écrit en root.
UID=1000
GID=1000

# --- Dev ---
# Ollama du serveur via tunnel SSH : ssh -N -L 11434:localhost:11434 root@srv852907.hstgr.cloud
OLLAMA_HOST=http://127.0.0.1:11434
PORT=8000

# --- Prod ---
DOMAIN=srv852907.hstgr.cloud
AUTH_USER=jules
# Hash bcrypt : docker run --rm -it caddy:2 caddy hash-password
# Guillemets simples OBLIGATOIRES (le hash contient des $).
AUTH_HASH='$2a$14$remplace-moi'
